{
  "name": "reserve-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down",
    "db:migrate": "yarn workspace @repo/db migrate",
    "db:generate": "yarn workspace @repo/db generate",
    "db:build": "yarn workspace @repo/db build",
    "db:studio": "yarn workspace @repo/db studio",
    "api:check-types": "yarn workspace api check-types",
    "api:lint": "yarn workspace api lint",
    "api:lint:fix": "yarn workspace api lint --fix",
    "api:format": "yarn workspace api format",
    "api:build": "yarn workspace api build",
    "api:dev": "yarn workspace api dev",
    "web:check-types": "yarn workspace web check-types",
    "web:lint": "yarn workspace web lint",
    "web:lint:fix": "yarn workspace web lint:fix",
    "web:format": "yarn workspace web format",
    "web:build": "yarn workspace web build",
    "web:dev": "yarn workspace web dev",
    "web:test": "yarn workspace web test",
    "web:test:watch": "yarn workspace web test:watch",
    "web:test:e2e": "yarn workspace web test:e2e --reporter=./e2e/reporters/pretty-console-reporter.ts --workers=1",
    "web:test:e2e:api": "yarn workspace web test:e2e e2e/api --reporter=./e2e/reporters/pretty-console-reporter.ts --workers=1",
    "web:test:e2e:ui": "yarn workspace web test:e2e --ui",
    "web:test:e2e:headed": "yarn workspace web test:e2e e2e/login.spec.ts --headed",
    "web:test:e2e:prod": "PLAYWRIGHT_BASE_URL=https://reserve-app-web.vercel.app PLAYWRIGHT_API_URL=https://reserve-app-djf2.onrender.com/v1 yarn workspace web test:e2e",
    "web:test:e2e:report": "yarn workspace web playwright show-report",
    "contracts:build": "yarn workspace @repo/api-contracts build",
    "contracts:check-types": "yarn workspace @repo/api-contracts check-types",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
