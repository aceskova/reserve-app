{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "API_URL",
    "NEXT_PUBLIC_API_URL",
    "PLAYWRIGHT_API_URL",
    "PLAYWRIGHT_BASE_URL",
    "E2E_USER_EMAIL",
    "E2E_USER_PASSWORD"
  ],
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"]
    }
  }
}
