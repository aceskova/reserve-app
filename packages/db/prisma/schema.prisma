generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdTrainingSessions TrainingSession[] @relation("TrainerSessions")
}

enum Role {
  USER
  TRAINER
  ADMIN
}

model HealthCheck {
  id        Int       @id
  note      String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  lastPing  DateTime? @map("last_ping") @db.Timestamptz

  @@map("health_check")
}

model TrainingSession {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String
  trainerId   String   @db.Uuid
  startsAtUtc DateTime
  endsAtUtc   DateTime
  capacity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trainer User @relation("TrainerSessions", fields: [trainerId], references: [id])
}

// TrainingSession
// id (uuid)
// title
// description
// trainerId (FK -> User)
// startsAtUtc
// endsAtUtc
// capacity
// //location
// createdAt
// updatedAt

// Reservation
// id (uuid)
// userId (FK -> User)
// trainingSessionId (FK -> TrainingSession)
// status (active | cancelled)
// cancelledAt
// createdAt
// updatedAt

// DeviceToken
// id (uuid)
// userId (FK -> User)
// token (unique)
// platform (ios | android | web)
// isActive
// createdAt
// updatedAt

// NotificationLog
// id (uuid)
// reservationId (FK -> Reservation)
// channel (email | push)
// type (reminder_48h | late_immediate)
// status (pending | sent | failed)
// scheduledForUtc
// sentAtUtc
// errorMessage
// retryCount
// createdAt
// updatedAt

// Vztahy mezi entitami
// User 1:N Reservation
// User 1:N DeviceToken
// User 1:N TrainingSession jako trainer
// TrainingSession 1:N Reservation
// Reservation 1:N NotificationLog
