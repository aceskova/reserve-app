generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  name         String   @db.VarChar(100)
  passwordHash String   @db.VarChar(255)
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  createdTrainingSessions TrainingSession[] @relation("TrainerSessions")
}

enum Role {
  USER
  TRAINER
  ADMIN
}

model HealthCheck {
  id        Int       @id
  note      String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  lastPing  DateTime? @map("last_ping") @db.Timestamptz

  @@map("health_check")
}

model TrainingSession {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(120)
  description String?  @db.VarChar(1000)
  trainerId   String   @db.Uuid
  startsAtUtc DateTime @db.Timestamptz
  endsAtUtc   DateTime @db.Timestamptz
  capacity    Int
  priceCents  Int
  currency    String   @default("CZK") @db.Char(3)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  trainer User @relation("TrainerSessions", fields: [trainerId], references: [id])

  @@index([startsAtUtc])
  @@index([trainerId, startsAtUtc])
}

